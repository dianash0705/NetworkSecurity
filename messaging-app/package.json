{
  "name": "teatime-messenger",
  "version": "1.0.0",
  "description": "TeaTime - A cozy messaging app with FastAPI backend",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:dev": "electron . --dev",
    "backend": "python -m uvicorn main:app --reload --host 127.0.0.1 --port 8000",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^40.1.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.teatime.messenger",
    "productName": "TeaTime",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "main.py",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "main.py",
        "to": "main.py"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "public/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    }
  },
  "keywords": ["messaging", "chat", "electron", "fastapi"],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
