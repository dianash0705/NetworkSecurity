{
  "name": "teatime-messenger",
  "version": "1.0.0",
  "description": "TeaTime - A cozy messaging app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:dev": "electron . --dev",
    "server": "node server.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^40.1.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.teatime.messenger",
    "productName": "TeaTime",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server.js",
      "database.json",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "public/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    }
  },
  "keywords": ["messaging", "chat", "electron"],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
